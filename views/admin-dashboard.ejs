<%- include('partials/head') %>
<main class="admin-shell admin-shell-modern">
  <aside class="admin-sidebar admin-sidebar-modern">
    <div class="brand-mark">
      <span class="brand-title">Cathrine Slim</span>
      <span class="brand-subtitle">Admin Dashboard</span>
    </div>
    <nav>
      <a class="<%= currentPath === '/itsiregar24/dashboard' ? 'active' : '' %>" href="/itsiregar24/dashboard">Dashboard</a>
      <a class="<%= currentPath.startsWith('/itsiregar24/products') ? 'active' : '' %>" href="/itsiregar24/products">Produk</a>
      <a class="<%= currentPath.startsWith('/itsiregar24/affiliates') ? 'active' : '' %>" href="/itsiregar24/affiliates">Affiliate</a>
      <a class="<%= currentPath.startsWith('/itsiregar24/shortlinks') ? 'active' : '' %>" href="/itsiregar24/shortlinks">Short Link</a>
      <a class="<%= currentPath.startsWith('/itsiregar24/articles') ? 'active' : '' %>" href="/itsiregar24/articles">Artikel</a>
      <a class="<%= currentPath.startsWith('/itsiregar24/promo') ? 'active' : '' %>" href="/itsiregar24/promo">Promo</a>
      <a class="<%= currentPath.startsWith('/itsiregar24/testimonials') ? 'active' : '' %>" href="/itsiregar24/testimonials">Testimoni</a>
      <a class="<%= currentPath.startsWith('/itsiregar24/settings') ? 'active' : '' %>" href="/itsiregar24/settings">SEO & Pengaturan</a>
    </nav>
    <form method="post" action="/itsiregar24/logout"><button class="btn btn-secondary btn-full" type="submit">Logout</button></form>
  </aside>

  <section class="admin-main admin-main-modern">
    <div class="admin-hero-head">
      <div>
        <h1>Selamat Datang, Admin</h1>
        <p>Kelola produk utama, produk promosi, artikel, dan short link dari satu dashboard.</p>
      </div>
    </div>

    <div class="admin-stat-grid admin-stat-grid-4">
      <div class="admin-card stat-card"><h2><%= counts.products %></h2><p>Produk Utama</p></div>
      <div class="admin-card stat-card"><h2><%= counts.affiliates %></h2><p>Produk Affiliate</p></div>
      <div class="admin-card stat-card"><h2><%= counts.articles %></h2><p>Artikel</p></div>
      <div class="admin-card stat-card"><h2><%= counts.promo %></h2><p>Promo</p></div>
    </div>

    <div class="quick-actions-grid">
      <a href="/itsiregar24/products/new" class="quick-action">Tambah Produk</a>
      <a href="/itsiregar24/affiliates/new" class="quick-action">Tambah Affiliate</a>
      <a href="/itsiregar24/shortlinks" class="quick-action">Buat Short Link</a>
      <a href="/itsiregar24/articles/new" class="quick-action">Tulis Artikel</a>
    </div>

    <div class="admin-two-col">
      <div class="admin-card">
        <div class="section-title-row">
          <h3>Kelola Produk Utama</h3>
          <a href="/itsiregar24/products" class="text-link">Lihat Semua</a>
        </div>
        <p>Gunakan menu Produk untuk mengelola katalog utama Cathrine Slim yang dipesan lewat WhatsApp.</p>
      </div>
      <div class="admin-card">
        <div class="section-title-row">
          <h3>Kelola Produk Affiliate</h3>
          <a href="/itsiregar24/affiliates" class="text-link">Lihat Semua</a>
        </div>
        <p>Menu Affiliate dipisahkan dari produk utama. Ini khusus untuk produk promosi marketplace dan link tujuan pembelian.</p>
      </div>
    </div>
  </section>
</main>
<script src="/main.js"></script>
</body>
</html>
