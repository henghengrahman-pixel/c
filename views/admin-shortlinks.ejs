<%- include('partials/head') %>
<main class="admin-shell"><aside class="admin-sidebar">
  <div class="brand-mark"><span class="brand-title">Cathrine Slim</span><span class="brand-subtitle">Official Store</span></div>
  <nav><a href="/itsiregar24/dashboard">Dashboard</a><a href="/itsiregar24/products">Produk &amp; Affiliate</a><a href="/itsiregar24/shortlinks">Short Link</a><a href="/itsiregar24/articles">Artikel</a><a href="/itsiregar24/promo">Promo</a><a href="/itsiregar24/testimonials">Testimoni</a><a href="/itsiregar24/settings">SEO &amp; Pengaturan</a></nav>
  <form method="post" action="/itsiregar24/logout"><button class="btn btn-secondary">Logout</button></form></aside>
<section class="admin-main"><h1>Short Link Manager</h1><p>Kelola banyak short link, termasuk tujuan affiliate Shopee.</p>
<div class="admin-stat-grid"><div class="admin-card"><h2><%= items.length %></h2><p>Total short link</p></div><div class="admin-card"><h2><%= items.filter(i => i.enabled).length %></h2><p>Aktif</p></div><div class="admin-card"><h2><%= items.filter(i => !i.enabled).length %></h2><p>Nonaktif</p></div><div class="admin-card"><h2><%= items.reduce((s,i) => s + (Number(i.clicks)||0),0) %></h2><p>Total klik</p></div></div>
<div class="admin-card"><h2 id="form-title">Buat Short Link</h2><form method="post" action="/itsiregar24/shortlinks/save" class="admin-form-grid" id="shortlink-form"><input type="hidden" name="id" id="sl-id"><label>Nama / Label<input type="text" name="label" id="sl-label" placeholder="Promo Speaker"></label><label>Nama Short Link<input name="slug" id="sl-slug" required pattern="[a-zA-Z0-9_-]{2,60}" placeholder="speaker"></label><label class="full">URL Tujuan / Affiliate<input type="url" name="url" id="sl-url" required placeholder="https://s.shopee.co.id/..."></label><label class="checkbox-label"><input type="checkbox" name="enabled" id="sl-enabled" checked> Aktif</label><div class="full"><button class="btn btn-primary" type="submit">Simpan Short Link</button> <button class="btn btn-secondary" type="button" onclick="resetLinkForm()">Batal / Baru</button></div></form></div>
<div class="admin-table-wrap"><div style="padding:16px"><input type="search" placeholder="Cari short link..." oninput="filterLinks(this.value)" style="padding:12px;width:100%;max-width:350px"></div><table class="admin-table"><thead><tr><th>Short Link</th><th>Tujuan</th><th>Status</th><th>Klik</th><th>Aksi</th></tr></thead><tbody>
<% items.forEach(function(item){ %><tr class="short-row"><td><a target="_blank" rel="noopener" href="/<%= item.slug %>"><%= baseUrl %>/<%= item.slug %></a><% if(item.label){ %><br><small><%= item.label %></small><% } %></td><td style="max-width:250px;overflow-wrap:anywhere"><%= item.url %></td><td><%= item.enabled ? 'Aktif' : 'Nonaktif' %></td><td><%= item.clicks||0 %></td><td><div class="table-actions"><button type="button" class="text-link edit-short" data-id="<%= item.id %>">Edit</button><button type="button" class="text-link copy-short" data-slug="<%= item.slug %>">Salin</button><form method="post" action="/itsiregar24/shortlinks/delete/<%= item.id %>" onsubmit="return confirm('Hapus short link ini?')"><button class="text-link danger-btn">Hapus</button></form></div></td></tr><% }); %>
</tbody></table></div></section></main>
<script id="sl-data" type="application/json"><%- JSON.stringify(items).replace(/</g, String.fromCharCode(92) + 'u003c') %></script>
<script>
const shortItems=JSON.parse(document.getElementById('sl-data').textContent);
function resetLinkForm(){document.getElementById('shortlink-form').reset();document.getElementById('sl-id').value='';document.getElementById('sl-enabled').checked=true;document.getElementById('form-title').textContent='Buat Short Link';}
function filterLinks(q){document.querySelectorAll('.short-row').forEach(r=>r.style.display=r.textContent.toLowerCase().includes(q.toLowerCase())?'':'none');}
document.querySelectorAll('.edit-short').forEach(b=>b.addEventListener('click',()=>{const i=shortItems.find(v=>v.id===b.dataset.id);if(!i)return;document.getElementById('sl-id').value=i.id;document.getElementById('sl-slug').value=i.slug;document.getElementById('sl-url').value=i.url;document.getElementById('sl-label').value=i.label||'';document.getElementById('sl-enabled').checked=!!i.enabled;document.getElementById('form-title').textContent='Edit Short Link';document.getElementById('form-title').scrollIntoView({behavior:'smooth'});}));
document.querySelectorAll('.copy-short').forEach(b=>b.addEventListener('click',()=>navigator.clipboard.writeText('<%= baseUrl %>/'+b.dataset.slug)));
</script><script src="/main.js"></script></body></html>