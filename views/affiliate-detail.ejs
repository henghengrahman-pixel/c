<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-main">
  <section class="section">
    <div class="container detail-grid detail-grid-soft">
      <div class="detail-image reveal visible">
        <% if(item.imageUrl){ %><img src="<%= item.imageUrl %>" alt="<%= item.name %>" style="width:100%;height:auto;border-radius:20px"><% } %>
      </div>
      <div class="detail-copy reveal visible">
        <p class="eyebrow"><a href="/rekomendasi">Rekomendasi Produk</a> / <%= item.platform %></p>
        <h1><%= item.name %></h1>
        <p class="price"><%= item.price || 'Lihat Harga' %></p>
        <p><%= item.shortDesc %></p>
        <div class="info-box">
          <p style="white-space:pre-line"><%= item.description %></p>
        </div>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/go/affiliate/<%= item.id %>" target="_blank" rel="sponsored nofollow noopener noreferrer"><%= item.platform ? 'Beli di ' + item.platform : (item.affiliateLabel || 'Belanja Sekarang') %></a>
          <a class="btn btn-secondary" href="/rekomendasi">Kembali ke Rekomendasi</a>
        </div>
        <p class="helper-note">Tautan pembelian akan mengarahkan Anda ke marketplace pihak ketiga yang sesuai.</p>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
