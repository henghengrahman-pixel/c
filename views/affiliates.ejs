<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-main">
  <section class="page-hero small page-soft-hero">
    <div class="container">
      <p class="eyebrow">Rekomendasi Pilihan</p>
      <h1>Rekomendasi Produk</h1>
      <p>Temukan berbagai produk pilihan dari marketplace terpercaya untuk kebutuhan sehari-hari.</p>
      <form class="search-form" method="get">
        <input name="q" value="<%= q %>" placeholder="Cari rekomendasi produk">
        <button class="btn btn-primary">Cari</button>
      </form>
    </div>
  </section>

  <section class="section">
    <div class="container recommendation-grid">
      <% items.forEach(function(item){ %>
        <article class="recommend-card">
          <a href="/rekomendasi/<%= item.slug %>" class="card-media">
            <% if(item.imageUrl){ %><img src="<%= item.imageUrl %>" alt="<%= item.name %>" loading="lazy"><% } %>
          </a>
          <div class="card-content">
            <p class="recommend-platform"><%= item.platform %> • <%= item.category %></p>
            <h2><a href="/rekomendasi/<%= item.slug %>"><%= item.name %></a></h2>
            <p><%= item.shortDesc %></p>
            <div class="card-bottom">
              <strong><%= item.price %></strong>
              <a href="/go/affiliate/<%= item.id %>" class="btn btn-market" target="_blank" rel="sponsored nofollow noopener noreferrer"><%= item.platform ? 'Beli di ' + item.platform : 'Belanja Sekarang' %></a>
            </div>
          </div>
        </article>
      <% }) %>

      <% if (!items.length){ %>
        <div class="empty-panel">
          <h3>Belum ada rekomendasi produk</h3>
          <p>Silakan tambahkan data pada menu admin agar halaman ini menampilkan produk rekomendasi.</p>
        </div>
      <% } %>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
