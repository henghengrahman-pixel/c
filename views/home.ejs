<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <section class="hero-section hero-soft">
    <div class="container hero-grid hero-public-grid">
      <div class="hero-copy reveal visible">
        <span class="chip-badge">Suplemen Diet & Wellness</span>
        <h1>Cathrine Slim</h1>
        <p class="hero-subtitle">Bantu program diet lebih efektif, sehat, dan tetap cantik.</p>
        <div class="hero-icon-grid">
          <div class="hero-icon-item"><span>⌘</span><small>Bantu<br>Kontrol Berat</small></div>
          <div class="hero-icon-item"><span>✦</span><small>Dukung<br>Pembakaran Lemak</small></div>
          <div class="hero-icon-item"><span>❀</span><small>Bahan<br>Alami Aman</small></div>
          <div class="hero-icon-item"><span>✓</span><small>Terdaftar<br>BPOM</small></div>
        </div>
        <div class="hero-actions">
          <a href="/produk" class="btn btn-primary">Pesan Sekarang</a>
          <a href="/produk" class="btn btn-secondary">Lihat Detail Produk</a>
        </div>
      </div>

      <div class="hero-product-stage reveal visible">
        <% const heroProduct = products && products[0]; %>
        <div class="hero-product-card">
          <% if (heroProduct && heroProduct.imageUrl) { %>
            <img src="<%= heroProduct.imageUrl %>" alt="<%= heroProduct.name %>">
          <% } %>
          <div class="hero-product-meta">
            <h2><%= heroProduct ? heroProduct.name : 'Cathrine Slim Original' %></h2>
            <p><%= heroProduct ? heroProduct.shortDesc : 'Produk unggulan Cathrine Slim.' %></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="trust-strip-section">
    <div class="container trust-strip">
      <div class="trust-item"><strong>Produk Original</strong><span>Garansi keaslian 100%</span></div>
      <div class="trust-item"><strong>Pengiriman Cepat</strong><span>Seluruh Indonesia</span></div>
      <div class="trust-item"><strong>Packing Aman</strong><span>Rapi & discreet</span></div>
      <div class="trust-item"><strong>Layanan Ramah</strong><span>Respon cepat via WhatsApp</span></div>
    </div>
  </section>

  <section class="section">
    <div class="container split-section">
      <div class="section-heading reveal visible">
        <p class="eyebrow">Produk Utama Kami</p>
        <h2>Cathrine Slim — Solusi Diet Sehat & Alami</h2>
        <p>Produk Cathrine Slim tetap menjadi fokus utama website ini. Pengunjung bisa melihat detail produk, manfaat, dan langsung pesan via WhatsApp dengan tampilan yang rapi dan meyakinkan.</p>
        <ul class="check-list">
          <li>Membantu program diet lebih optimal</li>
          <li>Mendukung pembakaran lemak</li>
          <li>Menjaga nafsu makan tetap terkontrol</li>
          <li>Bahan herbal alami dan aman dikonsumsi</li>
        </ul>
      </div>
      <div class="highlight-card reveal visible">
        <% const featured = products && products[0]; %>
        <h3><%= featured ? featured.name : 'Cathrine Slim' %></h3>
        <p class="mini-rating">★★★★★ <span>(4.9 / 5)</span></p>
        <p class="price-large"><%= featured ? featured.price : 'Rp325.000' %></p>
        <p class="muted-small"><%= featured ? featured.shortDesc : 'Produk pilihan Cathrine Slim.' %></p>
        <div class="stacked-actions">
          <a class="btn btn-primary btn-full" href="<%= whatsappLink %>" target="_blank" rel="noopener">Pesan via WhatsApp</a>
          <a class="btn btn-secondary btn-full" href="<%= featured ? '/produk/' + featured.slug : '/produk' %>">Lihat Detail Produk</a>
        </div>
      </div>
    </div>

    <div class="container product-grid product-grid-main">
      <% products.forEach(function(product){ %>
        <article class="product-card reveal visible">
          <a href="/produk/<%= product.slug %>" class="card-media">
            <img src="<%= product.imageUrl %>" alt="<%= product.name %>" loading="lazy">
          </a>
          <div class="card-content">
            <p class="card-kicker"><%= product.category %></p>
            <h3><a href="/produk/<%= product.slug %>"><%= product.name %></a></h3>
            <p><%= product.shortDesc %></p>
            <div class="card-bottom">
              <strong><%= product.price %></strong>
              <a href="/produk/<%= product.slug %>" class="text-link">Lihat Detail</a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="section alt-section section-recommendations">
    <div class="container section-heading reveal visible heading-with-action">
      <div>
        <p class="eyebrow">Produk Pilihan</p>
        <h2>Rekomendasi Produk untuk Kamu</h2>
        <p>Berbagai produk pilihan dari marketplace terpercaya. Untuk pelanggan, tampilannya natural seperti katalog rekomendasi biasa tanpa menonjolkan istilah teknis.</p>
      </div>
      <a href="/rekomendasi" class="btn btn-secondary">Lihat Semua Rekomendasi</a>
    </div>

    <div class="container recommendation-grid">
      <% if (recommendations && recommendations.length) { %>
        <% recommendations.forEach(function(item){ %>
          <article class="recommend-card reveal visible">
            <a href="/rekomendasi/<%= item.slug %>" class="card-media">
              <% if(item.imageUrl){ %><img src="<%= item.imageUrl %>" alt="<%= item.name %>" loading="lazy"><% } %>
            </a>
            <div class="card-content">
              <p class="recommend-platform"><%= item.platform || 'Marketplace' %></p>
              <h3><a href="/rekomendasi/<%= item.slug %>"><%= item.name %></a></h3>
              <p><%= item.shortDesc %></p>
              <div class="card-bottom">
                <strong><%= item.price || 'Lihat Harga' %></strong>
                <a href="/go/affiliate/<%= item.id %>" class="btn btn-market" target="_blank" rel="sponsored nofollow noopener noreferrer"><%= item.platform ? 'Beli di ' + item.platform : 'Belanja Sekarang' %></a>
              </div>
            </div>
          </article>
        <% }) %>
      <% } else { %>
        <div class="empty-panel">
          <h3>Belum ada rekomendasi produk</h3>
          <p>Anda bisa menambahkan produk rekomendasi dari admin agar section ini otomatis terisi.</p>
        </div>
      <% } %>
    </div>
  </section>

  <section class="section">
    <div class="container section-heading reveal visible">
      <p class="eyebrow">Testimoni</p>
      <h2>Testimoni Pelanggan</h2>
    </div>
    <div class="container testimonial-grid">
      <% testimonials.forEach(function(item){ %>
        <article class="testimonial-card reveal visible">
          <img src="<%= item.imageUrl %>" alt="Testimoni <%= item.name %>" loading="lazy">
          <div>
            <h3><%= item.name %></h3>
            <span><%= item.city %></span>
            <p>“<%= item.quote %>”</p>
          </div>
        </article>
      <% }) %>
    </div>
  </section>

  <section class="section alt-section">
    <div class="container section-heading reveal visible">
      <p class="eyebrow">Artikel</p>
      <h2>Informasi dan Tips Seputar Diet</h2>
      <p>Baca berbagai artikel dan tips seputar diet, menjaga berat badan, dan gaya hidup sehat.</p>
    </div>
    <div class="container article-grid two-col">
      <% articles.forEach(function(article){ %>
        <article class="article-card reveal visible">
          <a href="/artikel/<%= article.slug %>" class="card-media">
            <img src="<%= article.coverImage %>" alt="<%= article.title %>" loading="lazy">
          </a>
          <div class="card-content">
            <h3><a href="/artikel/<%= article.slug %>"><%= article.title %></a></h3>
            <p><%= article.excerpt %></p>
            <a href="/artikel/<%= article.slug %>" class="text-link">Baca Artikel</a>
          </div>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
