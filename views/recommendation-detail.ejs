<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-main recommendation-detail-page">
  <section class="section recommendation-detail-section">
    <div class="container detail-grid recommendation-detail-grid">
      <div class="detail-image">
        <% if(item.imageUrl){ %><img src="<%= item.imageUrl %>" alt="<%= item.name %>"><% } else { %><div class="recommendation-placeholder">Foto produk</div><% } %>
      </div>
      <div class="detail-copy recommendation-detail-copy">
        <p class="eyebrow"><a href="/rekomendasi">Rekomendasi Produk</a> / <%= item.category || 'Shopee' %></p>
        <h1><%= item.name %></h1>
        <p class="price"><%= item.price || 'Cek harga di Shopee' %></p>
        <p><%= item.shortDesc %></p>
        <p class="recommendation-description"><%= item.description %></p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/go/rekomendasi/<%= item.id %>" target="_blank" rel="sponsored nofollow noopener noreferrer">Beli di Shopee</a>
          <a class="btn btn-secondary" href="/rekomendasi">Lihat Produk Lainnya</a>
        </div>
        <p class="recommendation-note">Anda akan diarahkan ke Shopee untuk melihat informasi dan menyelesaikan pembelian.</p>
      </div>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
