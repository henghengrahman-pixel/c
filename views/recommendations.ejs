<%- include('partials/head') %>
<%- include('partials/header') %>
<main class="page-main recommendations-page">
  <section class="page-hero small">
    <div class="container">
      <p class="eyebrow">Pilihan untuk Kamu</p>
      <h1>Rekomendasi Produk</h1>
      <p>Temukan pilihan produk menarik untuk kebutuhan sehari-hari. Lihat detail dan belanja langsung di Shopee.</p>
      <form class="search-form" method="get" action="/rekomendasi">
        <input type="search" name="q" value="<%= q %>" placeholder="Cari rekomendasi produk" aria-label="Cari rekomendasi produk">
        <button class="btn btn-primary" type="submit">Cari Produk</button>
      </form>
    </div>
  </section>
  <section class="section">
    <div class="container recommendation-grid">
      <% items.forEach(function(item){ %>
        <article class="product-card recommendation-card">
          <a href="/rekomendasi/<%= item.slug %>" class="card-media">
            <% if (item.imageUrl) { %><img src="<%= item.imageUrl %>" alt="<%= item.name %>" loading="lazy"><% } else { %><span class="recommendation-placeholder">Foto produk</span><% } %>
          </a>
          <div class="card-content">
            <p class="card-kicker"><%= item.category || 'Pilihan Shopee' %></p>
            <h2><a href="/rekomendasi/<%= item.slug %>"><%= item.name %></a></h2>
            <p><%= item.shortDesc %></p>
            <strong class="recommendation-price"><%= item.price || 'Cek harga di Shopee' %></strong>
            <div class="recommendation-actions">
              <a class="btn btn-secondary" href="/rekomendasi/<%= item.slug %>">Lihat Detail</a>
              <a class="btn btn-primary" href="/go/rekomendasi/<%= item.id %>" target="_blank" rel="sponsored nofollow noopener noreferrer">Beli di Shopee</a>
            </div>
          </div>
        </article>
      <% }); %>
      <% if (!items.length) { %>
        <div class="recommendation-empty">
          <h2>Belum ada produk yang ditampilkan</h2>
          <p>Silakan lihat kembali nanti untuk rekomendasi produk terbaru.</p>
        </div>
      <% } %>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
